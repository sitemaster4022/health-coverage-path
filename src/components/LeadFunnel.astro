---
import { CONSENT_TEXT, CONSENT_VERSION } from '../consts';
interface Props { context?: string }
const { context = 'general' } = Astro.props;
---
<div class="funnel-backdrop" id="lead-funnel" role="dialog" aria-modal="true" aria-label="Check your coverage path" data-context={context} hidden>
  <div class="funnel">
    <div class="funnel-top">
      <div class="funnel-topline"><strong>Check your coverage path</strong><button class="funnel-close" type="button" name="close" aria-label="Close">×</button></div>
      <div class="progress-track" role="progressbar" aria-label="Form progress" aria-valuemin="1" aria-valuemax="8" aria-valuenow="1"><div class="progress-bar"></div></div>
    </div>
    <form class="funnel-body" id="lead-form" data-tf-element-role="offer" novalidate>
      <input class="honeypot" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="context" value={context} />
      <input type="hidden" name="consentVersion" value={CONSENT_VERSION} />

      <section class="funnel-step" data-step="1" data-step-name="coverage_change">
        <p class="eyebrow">Your situation</p>
        <h2 id="funnel-title">What brought you here today?</h2>
        <p class="muted">This helps us check which enrollment paths may apply to your situation.</p>
        <div class="choice-grid">
          <label class="choice"><input id="situation-job_loss" type="radio" name="situation" value="job_loss" required /> Lost job-based coverage</label>
          <label class="choice"><input id="situation-medicaid_loss" type="radio" name="situation" value="medicaid_loss" /> Losing or lost Medicaid</label>
          <label class="choice"><input id="situation-turning_26" type="radio" name="situation" value="turning_26" /> Turning 26 / aging off a parent’s plan</label>
          <label class="choice"><input id="situation-self_employed" type="radio" name="situation" value="self_employed" /> Self-employed / 1099 / between jobs</label>
          <label class="choice"><input id="situation-cobra" type="radio" name="situation" value="cobra" /> COBRA decision</label>
          <label class="choice"><input id="situation-other" type="radio" name="situation" value="other" /> Other life change</label>
          <label class="choice"><input id="situation-not_sure" type="radio" name="situation" value="not_sure" /> I’m not sure</label>
        </div>
      </section>

      <section class="funnel-step" data-step="2" data-step-name="coverage_timing">
        <p class="eyebrow">Coverage timing</p>
        <h2 id="timing-title">When did your coverage end—or when will it end?</h2>
        <div class="choice-grid" id="timing-options"></div>
        <p class="muted" id="timing-help">Timing can affect whether a Special Enrollment Period may be available.</p>
      </section>

      <section class="funnel-step" data-step="3" data-step-name="florida_zip">
        <p class="eyebrow">Start with your area</p><h2>What is your ZIP code?</h2>
        <div class="field"><label for="zip">ZIP code</label><input id="zip" name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="[0-9]{5}" placeholder="34952" required /></div>
        <p class="muted">Health plans and prices vary by area. Your ZIP helps us narrow down the options available where you live.</p>
      </section>

      <section class="funnel-step" data-step="4" data-step-name="coverage_household">
        <p class="eyebrow">Coverage and household</p><h2>Who needs coverage?</h2>
        <div class="choice-grid compact-choices">
          <label class="choice"><input id="coverageFor-self" type="radio" name="coverageFor" value="self" required /> Just me</label>
          <label class="choice"><input id="coverageFor-self_spouse" type="radio" name="coverageFor" value="self_spouse" /> Me and my spouse</label>
          <label class="choice"><input id="coverageFor-self_children" type="radio" name="coverageFor" value="self_children" /> Me and child or children</label>
          <label class="choice"><input id="coverageFor-family" type="radio" name="coverageFor" value="family" /> My family</label>
          <label class="choice"><input id="coverageFor-other" type="radio" name="coverageFor" value="other" /> Someone else</label>
        </div>
        <div class="field"><label for="household-size">Tax household size</label><select id="household-size" name="householdSize" required><option value="">Choose one</option>{Array.from({length: 8}, (_, i) => <option value={i + 1}>{i + 1}{i === 7 ? '+' : ''}</option>)}</select></div>
        <p class="muted">Household size can affect the income limits used to estimate Marketplace savings. Marketplace savings are based partly on the size of your tax household, even if not everyone needs coverage. This helps us give you a more accurate picture of what you may qualify for.</p>
      </section>

      <section class="funnel-step" data-step="5" data-step-name="income_range">
        <p class="eyebrow">Expected yearly income</p><h2>What do you expect your household to earn this year?</h2>
        <div class="choice-grid">
          <label class="choice"><input id="incomeRange-under_16000" type="radio" name="incomeRange" value="under_16000" required /> Under $16,000</label>
          <label class="choice"><input id="incomeRange-16000_29999" type="radio" name="incomeRange" value="16000_29999" /> $16,000–$29,999</label>
          <label class="choice"><input id="incomeRange-30000_49999" type="radio" name="incomeRange" value="30000_49999" /> $30,000–$49,999</label>
          <label class="choice"><input id="incomeRange-50000_79999" type="radio" name="incomeRange" value="50000_79999" /> $50,000–$79,999</label>
          <label class="choice"><input id="incomeRange-80000_plus" type="radio" name="incomeRange" value="80000_plus" /> $80,000 or more</label>
          <label class="choice"><input id="incomeRange-unsure" type="radio" name="incomeRange" value="unsure" /> I’m not sure yet</label>
        </div>
        <p class="muted">Your estimated income is one of the main factors used to determine whether you may qualify for savings that lower your monthly premium. Marketplace savings use expected full-year household income, including income earned before a job loss.</p>
        <p class="muted">This may help identify potential premium savings; the official Marketplace makes the eligibility decision.</p>
      </section>

      <section class="funnel-step" data-step="6" data-step-name="coverage_status">
        <p class="eyebrow">Current coverage</p><h2>Which best describes your coverage right now?</h2>
        <p class="muted">This helps us understand which next steps may fit your situation.</p>
        <div class="choice-grid">
          <label class="choice"><input id="coverageStatus-ending" type="radio" name="coverageStatus" value="ending" required /> Coverage will end soon</label>
          <label class="choice"><input id="coverageStatus-lost" type="radio" name="coverageStatus" value="lost" /> Coverage already ended</label>
          <label class="choice"><input id="coverageStatus-cobra_offered" type="radio" name="coverageStatus" value="cobra_offered" /> COBRA was offered</label>
          <label class="choice"><input id="coverageStatus-on_cobra" type="radio" name="coverageStatus" value="on_cobra" /> I’m enrolled in COBRA</label>
          <label class="choice"><input id="coverageStatus-uninsured" type="radio" name="coverageStatus" value="uninsured" /> I do not currently have coverage</label>
        </div>
      </section>

      <section class="funnel-step" data-step="7" data-step-name="contact_identity">
        <p class="eyebrow">Request help</p><h2>We have enough information to narrow down your next steps.</h2>
        <p class="muted">Enter your contact information to request help reviewing coverage options available in your area.</p>
        <div class="grid-2"><div class="field"><label for="first-name">First name</label><input id="first-name" name="firstName" autocomplete="given-name" required /></div><div class="field"><label for="last-name">Last name</label><input id="last-name" name="lastName" autocomplete="family-name" required /></div></div>
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
      </section>

      <section class="funnel-step" data-step="8" data-step-name="phone_consent">
        <p class="eyebrow">Final step</p><h2>What is the best number to reach you?</h2>
        <p class="muted">A phone number lets a licensed insurance professional or approved partner follow up about coverage options. We ask for it last, after the coverage questions.</p>
        <div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(772) 555-0123" required /></div>
        <div class="consent-block" data-tf-element-role="consent-language">
          <label class="choice"><input id="consent" type="checkbox" name="consent" value="yes" data-tf-element-role="consent-opt-in" required /> <span>I agree to the contact and sharing terms below.</span></label>
          <p class="consent-copy">{CONSENT_TEXT}</p>
          <p class="consent-copy">HealthCoveragePath is not HealthCare.gov or a government website. A licensed insurance professional or approved partner may contact you. You may also use HealthCare.gov directly without submitting this form.</p>
        </div>
      </section>

      <section class="funnel-step" data-step="9" data-step-name="success" aria-live="polite">
        <div class="success-mark" aria-hidden="true">✓</div><h2>Thanks—your coverage request is in.</h2><p>We saved the details you provided. If your request can be matched, a licensed insurance professional or approved coverage partner may contact you about available options.</p><p class="muted">Submitting this form does not enroll you in a plan. For immediate official Marketplace help, visit <a href="https://www.healthcare.gov/">HealthCare.gov</a>.</p>
      </section>
      <div class="funnel-error" id="funnel-error" role="alert"></div>
      <div class="funnel-actions"><button class="button secondary small" type="button" name="back" data-back hidden>Back</button><button class="button" type="submit" name="lead_submit" data-next data-tf-element-role="submit"><span data-tf-element-role="submit-text">Continue</span></button></div>
    </form>
  </div>
</div>
<div class="mobile-cta"><button class="button" type="button" data-funnel-open data-analytics="mobile_sticky_cta">Check My Options</button></div>

<script is:inline type="text/javascript">
  (() => {
    const tf = document.createElement('script');
    tf.type = 'text/javascript';
    tf.async = true;
    tf.src = (document.location.protocol === 'https:' ? 'https' : 'http') +
      '://api.trustedform.com/trustedform.js?field=xxTrustedFormCertUrl&use_tagged_consent=true&l=' +
      new Date().getTime() + Math.random();
    const firstScript = document.getElementsByTagName('script')[0];
    firstScript?.parentNode?.insertBefore(tf, firstScript);
  })();
</script>
<noscript><img src="https://api.trustedform.com/ns.gif" alt="" /></noscript>

<script>
  type FirstTouch = { originalLandingUrl:string; originalLandingPath:string; referrer:string|null; attribution:Record<string,string|null> };
  const modal = document.querySelector<HTMLElement>('#lead-funnel');
  const form = document.querySelector<HTMLFormElement>('#lead-form');
  const error = document.querySelector<HTMLElement>('#funnel-error');
  const next = document.querySelector<HTMLButtonElement>('[data-next]');
  const nextLabel = next?.querySelector<HTMLElement>('[data-tf-element-role="submit-text"]');
  const back = document.querySelector<HTMLButtonElement>('[data-back]');
  const close = document.querySelector<HTMLButtonElement>('.funnel-close');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.funnel-step'));
  const contextInput = form?.elements.namedItem('context') as HTMLInputElement | null;
  const initialContext = modal?.dataset.context || 'general';
  const STEP = { situation:1, timing:2, zip:3, household:4, income:5, status:6, contact:7, consent:8, success:9 } as const;
  const generalFlow = [STEP.zip, STEP.household, STEP.income, STEP.situation, STEP.timing, STEP.status, STEP.contact, STEP.consent];
  const targetedFlow = [STEP.zip, STEP.household, STEP.income, STEP.timing, STEP.status, STEP.contact, STEP.consent];
  let flow = initialContext === 'general' ? [...generalFlow] : [...targetedFlow];
  let flowIndex = 0;
  let startedAt = 0;
  let completed = false;
  let previousFocus: HTMLElement | null = null;

  const timingSets: Record<string, { title:string; help:string; options:[string,string][] }> = {
    job_loss:{ title:'When did your employer coverage end—or when will it end?', help:'Timing can affect whether a Special Enrollment Period may be available. A general range is enough.', options:[['already_ended','Coverage already ended'],['next_30','Ends within the next 30 days'],['days_31_60','Ends in 31–60 days'],['over_60_future','Ends more than 60 days from now'],['over_60_past','Ended more than 60 days ago'],['unsure','I’m not sure']] },
    cobra:{ title:'When did your employer coverage end—or when will it end?', help:'Timing can affect whether a Special Enrollment Period may be available and helps compare it with your COBRA election window.', options:[['already_ended','Coverage already ended'],['next_30','Ends within the next 30 days'],['days_31_60','Ends in 31–60 days'],['over_60_future','Ends more than 60 days from now'],['over_60_past','Ended more than 60 days ago'],['unsure','I’m not sure']] },
    medicaid_loss:{ title:'When did your Medicaid coverage end—or when will it end?', help:'Timing can affect whether a Special Enrollment Period may be available. A general range is enough.', options:[['already_ended','Medicaid already ended'],['next_30','Ends within the next 30 days'],['days_31_60','Ends in 31–60 days'],['over_60_future','Ends more than 60 days from now'],['over_60_past','Ended more than 60 days ago'],['unsure','I’m not sure']] },
    turning_26:{ title:'When will coverage through a parent end?', help:'Timing can affect whether a Special Enrollment Period may be available. The plan type can affect the exact end date; a range is enough.', options:[['already_ended','It already ended'],['next_30','Within the next 30 days'],['days_31_60','In 31–60 days'],['over_60_future','More than 60 days from now'],['over_60_past','It ended more than 60 days ago'],['unsure','I’m not sure']] },
    self_employed:{ title:'When do you need new coverage to start?', help:'Timing can affect whether a Special Enrollment Period may be available. Choose the closest range.', options:[['need_now','As soon as possible'],['next_30','Within the next 30 days'],['days_31_60','In 31–60 days'],['over_60_future','More than 60 days from now'],['unsure','I’m not sure']] },
    special_enrollment:{ title:'When did the life change happen?', help:'Timing can affect whether a Special Enrollment Period may be available. A general range is enough to organize the possible enrollment window.', options:[['event_last_30','Within the last 30 days'],['event_31_60','31–60 days ago'],['event_over_60','More than 60 days ago'],['next_30','It will happen within 30 days'],['unsure','I’m not sure']] },
    unemployed:{ title:'When did your previous coverage end—or when will it end?', help:'Timing can affect whether a Special Enrollment Period may be available. A general range is enough.', options:[['already_ended','Coverage already ended'],['next_30','Ends within the next 30 days'],['days_31_60','Ends in 31–60 days'],['over_60_future','Ends more than 60 days from now'],['over_60_past','Ended more than 60 days ago'],['unsure','I’m not sure']] },
    other:{ title:'When did the coverage change happen?', help:'Timing can affect whether a Special Enrollment Period may be available. Choose the closest range.', options:[['event_last_30','Within the last 30 days'],['event_31_60','31–60 days ago'],['event_over_60','More than 60 days ago'],['next_30','It will happen within 30 days'],['unsure','I’m not sure']] },
    not_sure:{ title:'When did your coverage change—or when do you need coverage?', help:'Timing can affect whether a Special Enrollment Period may be available. Choose the closest answer—it is okay to be unsure.', options:[['already_ended','Coverage already ended'],['need_now','I need coverage as soon as possible'],['next_30','A change is coming within 30 days'],['days_31_60','A change is coming in 31–60 days'],['unsure','I’m not sure']] },
  };

  const currentContext = () => contextInput?.value || initialContext;
  const readTrustedFormCertificate = () => {
    const value = ((form?.elements.namedItem('xxTrustedFormCertUrl') as HTMLInputElement | null)?.value || '').trim();
    return value.startsWith('https://cert.trustedform.com/') ? value : null;
  };
  const track = (event: string, detail: Record<string, unknown> = {}) => {
    const payload = { event, landing_page: location.pathname, funnel_context: currentContext(), ...detail };
    window.dispatchEvent(new CustomEvent('hcp:analytics', { detail: payload }));
    const w = window as typeof window & { hcpDataLayer?: Record<string, unknown>[]; plausible?: (e: string, o: unknown) => void };
    w.hcpDataLayer?.push(payload); w.plausible?.(event, { props: payload });
  };

  const renderTiming = (context: string) => {
    const set = timingSets[context] || timingSets.not_sure;
    const title = document.querySelector<HTMLElement>('#timing-title');
    const help = document.querySelector<HTMLElement>('#timing-help');
    const options = document.querySelector<HTMLElement>('#timing-options');
    if (title) title.textContent = set.title;
    if (help) help.textContent = set.help;
    if (!options) return;
    options.replaceChildren(...set.options.map(([value,label], index) => {
      const wrapper = document.createElement('label'); wrapper.className = 'choice';
      const input = document.createElement('input'); input.id = `timing-${context}-${value}`; input.type = 'radio'; input.name = 'timingBucket'; input.value = value; input.required = index === 0;
      wrapper.append(input, document.createTextNode(` ${label}`)); return wrapper;
    }));
  };

  const show = (index: number) => {
    flowIndex = index;
    const stepNumber = flow[index];
    steps.forEach((el) => el.classList.toggle('active', Number(el.dataset.step) === stepNumber));
    const bar = document.querySelector<HTMLElement>('.progress-bar');
    const progress = document.querySelector<HTMLElement>('.progress-track');
    const position = Math.min(index + 1, flow.length);
    if (bar) bar.style.width = `${position / flow.length * 100}%`;
    progress?.setAttribute('aria-valuemax', String(flow.length)); progress?.setAttribute('aria-valuenow', String(position));
    if (back) back.hidden = index === 0 || stepNumber === STEP.success;
    if (next) {
      next.hidden = stepNumber === STEP.success;
      if (nextLabel) {
        nextLabel.textContent = stepNumber === STEP.success
          ? ''
          : index === flow.length - 1
            ? 'Check My Options'
            : stepNumber === STEP.zip
              ? 'See Available Options'
              : stepNumber === STEP.income
                ? 'Check Potential Savings'
                : 'Continue';
      }
    }
    if (error) error.textContent = '';
    steps.find((el) => Number(el.dataset.step) === stepNumber)?.querySelector<HTMLElement>('input, select, button')?.focus();
  };

  const activeStep = () => steps.find((el) => Number(el.dataset.step) === flow[flowIndex]);
  const valid = () => {
    for (const field of Array.from(activeStep()?.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select') ?? [])) {
      if (!field.checkValidity()) { field.reportValidity(); return false; }
    }
    if (flow[flowIndex] === STEP.zip) {
      const zip = (form?.elements.namedItem('zip') as HTMLInputElement)?.value ?? '';
      if (!/^3\d{4}$/.test(zip)) { if (error) error.textContent = 'Enter a valid Florida ZIP code.'; return false; }
    }
    return true;
  };

  renderTiming(initialContext);
  const open = (trigger: HTMLElement) => {
    if (!modal) return;
    previousFocus = trigger; startedAt = Date.now(); completed = false;
    flow = initialContext === 'general' ? [...generalFlow] : [...targetedFlow]; flowIndex = 0;
    if (contextInput) contextInput.value = initialContext;
    if (next) next.disabled = false;
    renderTiming(initialContext);
    modal.hidden = false; modal.classList.add('open'); document.body.classList.add('funnel-open'); show(0);
    track('funnel_start', { cta: trigger.dataset.analytics ?? 'content_cta', total_steps:flow.length });
  };
  const shut = () => {
    if (!modal) return;
    if (startedAt && !completed) {
      const active = activeStep(); track('funnel_abandon', { step_number:flowIndex + 1, step_name:active?.dataset.stepName, total_steps:flow.length });
    }
    modal.classList.remove('open'); modal.hidden = true; document.body.classList.remove('funnel-open'); previousFocus?.focus();
  };

  document.querySelectorAll<HTMLElement>('[data-funnel-open]').forEach((el) => el.addEventListener('click', () => { track('page_cta_click', { cta:el.dataset.analytics ?? 'content_cta' }); open(el); }));
  close?.addEventListener('click', shut);
  modal?.addEventListener('click', (event) => { if (event.target === modal) shut(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && modal?.classList.contains('open')) shut(); });
  form?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (!input.matches('.choice input')) return;
    document.querySelectorAll(`input[name="${input.name}"]`).forEach((el) => el.closest('.choice')?.classList.remove('selected'));
    input.closest('.choice')?.classList.add('selected');
  });
  back?.addEventListener('click', () => show(Math.max(0, flowIndex - 1)));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !next || !valid()) return;
    const active = activeStep();
    if (flow[flowIndex] === STEP.situation) {
      const selected = (form.elements.namedItem('situation') as RadioNodeList)?.value;
      if (contextInput) contextInput.value = selected;
      renderTiming(selected);
    }
    if (flowIndex < flow.length - 1) {
      track('funnel_step_complete', { step_number:flowIndex + 1, step_name:active?.dataset.stepName, total_steps:flow.length });
      show(flowIndex + 1); return;
    }
    next.disabled = true; if (nextLabel) nextLabel.textContent = 'Checking…';
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    delete data.xxTrustedFormToken;
    delete data.xxTrustedFormPingUrl;
    const trustedFormCertificateUrl = readTrustedFormCertificate();
    track(trustedFormCertificateUrl ? 'trustedform_certificate_available' : 'trustedform_certificate_missing');
    if (trustedFormCertificateUrl && !data.xxTrustedFormCertUrl) data.xxTrustedFormCertUrl = trustedFormCertificateUrl;
    const firstTouch = (window as typeof window & { hcpGetAttribution?:()=>FirstTouch }).hcpGetAttribution?.();
    const payload = { ...data, originalLandingUrl:firstTouch?.originalLandingUrl || location.pathname,
      originalLandingPath:firstTouch?.originalLandingPath || location.pathname, submissionPath:location.pathname,
      referrer:firstTouch?.referrer || document.referrer || null, attribution:firstTouch?.attribution || {},
      startedAt, completedAt:Date.now() };
    try {
      track('lead_submit', { step_number:flow.length, step_name:active?.dataset.stepName, total_steps:flow.length });
      const response = await fetch('/api/leads', { method:'POST', headers:{ 'content-type':'application/json' }, body:JSON.stringify(payload) });
      const result = await response.json() as { id?:string; status?:string; duplicate?:boolean; error?:string };
      if (!response.ok) throw new Error(result.error || 'submit_failed');
      completed = true; track('funnel_step_complete', { step_number:flow.length, step_name:active?.dataset.stepName, total_steps:flow.length });
      if (result.duplicate) track('lead_duplicate', { routing_status:result.status });
      else track('lead_success', { lead_id:result.id, routing_status:result.status });
      flow = [...flow, STEP.success]; show(flow.length - 1); form.reset();
      form.querySelectorAll('.choice.selected').forEach((choice) => choice.classList.remove('selected'));
    } catch {
      track('lead_failure', { step_number:flow.length, step_name:active?.dataset.stepName, total_steps:flow.length });
      if (error) error.textContent = 'We could not securely save your request. Your answers remain here so you can try again.';
      next.disabled = false; if (nextLabel) nextLabel.textContent = 'Check My Options';
    }
  });
</script>
